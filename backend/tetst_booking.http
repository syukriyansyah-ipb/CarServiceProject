### 1. Create booking
POST http://localhost:5017/api/bookings
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..MXyx8Ys3kYlvHB1sYAmAQfV_tV1u1zH8t7ZgpUKrFU8
Content-Type: application/json

{
  "customerId": 1,
  "vehicleId": 5,
  "dealerId": 1,
  "serviceTypeId": 1,
  "bookingDate": "2026-10-12",
  "bookingTime": "14:00:00",
  "complaintNotes": "Test alur lengkap",
  "kmAtService": 15000
}

### 2. Confirm
PUT http://localhost:5017/api/bookings/3/confirm
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..MXyx8Ys3kYlvHB1sYAmAQfV_tV1u1zH8t7ZgpUKrFU8

### 3. Assign mekanik
PUT http://localhost:5017/api/bookings/3/assign-mechanic
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..MXyx8Ys3kYlvHB1sYAmAQfV_tV1u1zH8t7ZgpUKrFU8
Content-Type: application/json

{
  "mechanicId": 1
}

### 4. Start
PUT http://localhost:5017/api/bookings/3/start
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..MXyx8Ys3kYlvHB1sYAmAQfV_tV1u1zH8t7ZgpUKrFU8

### 5. Complete - auto-generate history + invoice
PUT http://localhost:5017/api/bookings/3/complete
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..MXyx8Ys3kYlvHB1sYAmAQfV_tV1u1zH8t7ZgpUKrFU8
Content-Type: application/json

{
  "kmAtService": 15100,
  "actualCost": 850000,
  "advisorNotes": "Ganti oli, filter oli, cek rem depan (kampas 60%). Ada bunyi dari bearing - sarankan cek 3 bulan lagi."
}

{
  "message": "Booking selesai. ServiceHistory dan Invoice otomatis dibuat.",
  "bookingId": 3,
  "serviceHistoryId": 1,
  "invoiceId": 1,
  "invoiceNumber": "INV-20261010-001",
  "totalAmount": 943500.00
}

### 6. Get service history yang baru dibuat
GET http://localhost:5017/api/servicehistories/1
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..MXyx8Ys3kYlvHB1sYAmAQfV_tV1u1zH8t7ZgpUKrFU8

### 7. Get invoice
GET http://localhost:5017/api/invoices/1
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..MXyx8Ys3kYlvHB1sYAmAQfV_tV1u1zH8t7ZgpUKrFU8

### 8. Bayar sebagian (500.000)
POST http://localhost:5017/api/invoices/1/pay
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..MXyx8Ys3kYlvHB1sYAmAQfV_tV1u1zH8t7ZgpUKrFU8
Content-Type: application/json

{
  "paidAmount": 500000,
  "paymentMethod": "Transfer"
}

### 9. Bayar sisa
POST http://localhost:5017/api/invoices/1/pay
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..MXyx8Ys3kYlvHB1sYAmAQfV_tV1u1zH8t7ZgpUKrFU8
Content-Type: application/json

{
  "paidAmount": 443500,
  "paymentMethod": "Transfer"
}

### 10. Get invoice (harus Paid)
GET http://localhost:5017/api/invoices/1
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..MXyx8Ys3kYlvHB1sYAmAQfV_tV1u1zH8t7ZgpUKrFU8

### 11. Bayar invoice yang sudah lunas - HARUS 400
POST http://localhost:5017/api/invoices/1/pay
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..MXyx8Ys3kYlvHB1sYAmAQfV_tV1u1zH8t7ZgpUKrFU8
Content-Type: application/json

{
  "paidAmount": 100000,
  "paymentMethod": "Cash"
}

### 12. Riwayat servis Xpander Budi (vehicleId=5)
GET http://localhost:5017/api/servicehistories?vehicleId=5
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..MXyx8Ys3kYlvHB1sYAmAQfV_tV1u1zH8t7ZgpUKrFU8

### 13. Invoice yang belum dibayar
GET http://localhost:5017/api/invoices?status=Unpaid
Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..MXyx8Ys3kYlvHB1sYAmAQfV_tV1u1zH8t7ZgpUKrFU8

