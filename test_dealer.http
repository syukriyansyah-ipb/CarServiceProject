Content-Type: application/json

{
  "code": "MTR-JKT-01",
  "name": "Mitsubishi Jakarta Selatan",
  "address": "Jl. TB Simatupang No. 10",
  "city": "Jakarta",
  "province": "DKI Jakarta",
  "phone": "021-12345678",
